# anyOS System Environment
# This file is sourced by the Terminal on startup.
# Supports: KEY=VALUE, export KEY=VALUE, source /path/to/file, # comments

export PATH=/System/bin:/System/sbin
export HOME=/
export USER=root
export SHELL=/System/terminal
export TERM=anyos
export ANYOS_SRC=/Libraries/system/src/anyos
export ANYOS_RUST_SRC=/Libraries/system/src/anyos/libs
export CRUST=/System/bin/crust
export CCARGO=/System/bin/ccargo
export GIT=/System/bin/git
export RUSTC=/System/bin/rustc
export CARGO=/System/bin/cargo
