#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

make -C "${ROOT_DIR}/libs/libcorevm/bios" >/dev/null

cargo +stable run \
  --manifest-path "${ROOT_DIR}/libs/libcorevm-hosttests/Cargo.toml" \
  --target x86_64-unknown-linux-gnu \
  --bin test_vmd \
  -- "$@"
