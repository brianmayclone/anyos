#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

cargo +stable run \
  --config "build.rustflags = [\"-L\", \"native=${ROOT_DIR}/libs/libcorevm-hosttests/native-libs\"]" \
  --manifest-path "${ROOT_DIR}/libs/libcorevm-hosttests/Cargo.toml" \
  --target x86_64-unknown-linux-gnu \
  --bin test_vmd_x11 \
  -- "$@"
